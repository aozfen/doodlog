{
  "name": "doodlog-worker",
  "private": true,
  "type": "module",
  "description": "Doodlog API: Gemini proxy and brush balance. See ../MIMARI.md.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply doodlog --local",
